# LANGSMITH_API_KEY 只是凭据,真正打开上报的是 LANGSMITH_TRACING
# langgraph dev 会自动开启;uvicorn / pytest / 裸 python 跑必须显式设为 true
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=intelligence-analysis
LANGSMITH_API_KEY=lsv

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com
# 免费额度可用:gpt-oss:120b / gpt-oss:20b / nemotron-3-nano:30b / gemma4:31b
# glm-5.x、deepseek-v4、kimi、minimax、qwen3.5 均需订阅(403)
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=

TAVILY_API_KEY=
