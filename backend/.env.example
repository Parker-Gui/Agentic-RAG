# 复制为 backend/.env；从 backend/ 启动后端。密钥填在 .env 中。
# DeepSeek 通过项目已有的 OpenAI 兼容接口调用。
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com
# 官方当前 Flash 名称；旧名 deepseek-v4-flash 已映射至更新的 Flash 服务。
OPENAI_MODEL=deepseek-flash
OPENAI_AVAILABLE_MODELS=["deepseek-flash"]
OPENAI_API_KEY=

# 本机 BGE-m3 用于 Mem0 profile 嵌入；不需要 Ollama 云端密钥。
OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_EMBED_PROVIDER=ollama
RAG_OLLAMA_EMBED_MODEL=bge-m3
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ollama 仅提供稠密向量。需要稀疏混合检索时使用 FlagEmbedding 并重建索引。
RAG_HYBRID_ENABLED=false

# Use documents after migration and historical mapping; legacy keeps article_chunks.
RAG_INDEX_SOURCE=legacy

# 可选在线 trace，需要时填写密钥并开启。
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=intelligence-analysis
LANGSMITH_API_KEY=

# Langfuse Cloud: off by default; normal API exports allowlisted metadata only.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SHUTDOWN_SECONDS=3

# Agent application budgets (estimates, not provider window specifications)
AGENT_HISTORY_TURNS=3
AGENT_HISTORY_TOKENS=8000
AGENT_INPUT_TOKENS=32000
AGENT_SUMMARY_TRIGGER_TOKENS=24000
AGENT_KEEP_TOKENS=8000
AGENT_OUTPUT_TOKENS=4096
AGENT_MAX_DRAFT_CHARS=6000

TAVILY_API_KEY=
